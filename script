#!/usr/bin/env bash
# scripts/repo-hash.sh
# Usage:
#   ./scripts/repo-hash.sh          # hash tracked files only (recommended)
#   ./scripts/repo-hash.sh -u|--include-untracked
#     # include untracked files (reduces determinism across clones)
#
# Prints a single SHA-256 fingerprint for the repository (based on file contents).
set -euo pipefail

# Check for include-untracked flag
INCLUDE_UNTRACKED=0
if [ "${1:-}" = "--include-untracked" ] || [ "${1:-}" = "-u" ]; then
  INCLUDE_UNTRACKED=1
fi

# Pick a hashing tool
if command -v sha256sum >/dev/null 2>&1; then
  HS_CMD="sha256sum"
elif command -v shasum >/dev/null 2>&1; then
  HS_CMD="shasum -a 256"
else
  echo "Error: sha256sum or shasum required in PATH" >&2
  exit 2
fi

# Build the git file list
if [ "$INCLUDE_UNTRACKED" -eq 1 ]; then
  # tracked + untracked (exclude files matched by .gitignore)
  LIST_CMD="git ls-files -z --cached --others --exclude-standard"
else
  # tracked only
  LIST_CMD="git ls-files -z"
fi

# Generate per-file hashes deterministically and then hash that list
# We print only the final hex fingerprint.
eval "$LIST_CMD" \
  | tr '\0' '\n' \
  | sort \
  | while IFS= read -r file; do
      # Skip if file disappeared
      if [ -f "$file" ]; then
        # Compute per-file hash line like: "<hash>  <path>"
        $HS_CMD -- "$file" 2>/dev/null || $HS_CMD "$file"
      else
        echo "warning: file disappeared: $file" >&2
      fi
    done \
  | $HS_CMD \
  | awk '{print $1}'
